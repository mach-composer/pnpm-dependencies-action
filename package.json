{
  "name": "pnpm-dependencies-action",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "license": "MIT",
  "author": "Lab Digital",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.mjs",
    "format": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --cache",
    "format:fix": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --cache --log-level=warn",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@actions/core": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "rolldown": "1.2.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0"
}
